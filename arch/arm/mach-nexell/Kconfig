if ARCH_NEXELL

config ARCH_S5P4418
	bool "Nexell S5P4418 SoC"
	select CPU_V7A
	select OF_CONTROL
	select NX_GPIO
	select DM_SERIAL
	select PL01X_SERIAL
	help
	  Enable support for Nexell S5P4418 SoC.

config ARCH_S5P6818
	bool "Nexell S5P6818 SoC"
	select OF_CONTROL
	select NX_GPIO
	select DM_SERIAL
	help
	  Enable common support for the Nexell S5P6818 SoC. Board targets
	  select either the AArch32 or AArch64 execution state.

menu "Nexell S5P4418/S5P6818"
	depends on ARCH_NEXELL

choice
	prompt "Nexell S5P4418/S5P6818 board select"
	optional

config TARGET_NANOPI2
	bool "FriendlyARM NanoPi2 / NanoPC-T2 Board"
	select ARCH_S5P4418
	help
	  Enable support for FriendlyARM NanoPi2 and NanoPC-T2 Boards.

config TARGET_X6818
	bool "Nexell S5P6818 x6818 board"
	select ARCH_S5P6818
	select CPU_V7A
	help
	  Enable support for the Nexell S5P6818 x6818 board (AArch32).

config TARGET_X6818_ARM64
	bool "Nexell S5P6818 x6818 board (AArch64 BL33)"
	select ARCH_S5P6818
	select ARM64
	select ARM_SMCCC
	select SYSRESET
	select SYSRESET_NEXELL_PSCI
	help
	  Enable the AArch64 x6818 BL33 target entered by TF-A at EL2. This
	  target uses the Nexell SoC timer and PSCI firmware interfaces. The
	  S5P6818 does not provide a running counter to the architectural timer.

endchoice

config SYS_PLLFIN
	int

config TIMER_SYS_TICK_CH
	int

config SYS_BOARD
	default "nanopi2" if TARGET_NANOPI2
	default "x6818" if TARGET_X6818
	default "x6818" if TARGET_X6818_ARM64

config SYS_VENDOR
	default "friendlyarm"

config SYS_SOC
	default "nexell"

config SYS_CONFIG_NAME
	default "s5p4418_nanopi2" if TARGET_NANOPI2
	default "x6818" if TARGET_X6818
	default "x6818" if TARGET_X6818_ARM64

config SYS_PLLFIN
	default 24000000

config TIMER_SYS_TICK_CH
	default 0

endmenu

source "board/friendlyarm/Kconfig"

endif
