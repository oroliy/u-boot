/*
 * Nexell S5P6818 x6818 board device tree (AArch32, headless).
 *
 * Enables UART0 (console) and the dwmmc controllers (mmc0 = SD,
 * mmc2 = eMMC). No display.
 */

/dts-v1/;
#include "s5p6818.dtsi"

/ {
	model = "Nexell S5P6818 x6818";
	compatible = "nexell,s5p6818";

	aliases {
		serial0 = "/uart@c00a1000";
	};

	mmc0:mmc@c0062000 {
		frequency = <50000000>;
		drive_dly = <0x0>;
		drive_shift = <0x03>;
		sample_dly = <0x00>;
		sample_shift = <0x02>;
		mmcboost = <0>;
		status = "okay";
	};

	mmc2:mmc@c0069000 {
		frequency = <50000000>;
		drive_dly = <0x0>;
		drive_shift = <0x03>;
		sample_dly = <0x00>;
		sample_shift = <0x02>;
		mmcboost = <0>;
		status = "okay";
	};

	uart0:uart@c00a1000 {
		skip-init;
		status = "okay";
	};
};
